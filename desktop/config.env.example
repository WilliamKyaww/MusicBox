# MusicBox desktop settings. Restart MusicBox after editing.
YOUTUBE_API_KEY=
DISCORD_PRESENCE_ENABLED=false
DISCORD_CLIENT_ID=
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
MAX_CONCURRENT_DOWNLOADS=2
# Optional Movies foundation preview; no catalogue or movie playback yet.
MOVIES_ENABLED=false
YOUTUBE_SEARCH_CACHE_TTL_SECONDS=300
# Optional Netscape cookies file for your own YouTube session.
YOUTUBE_COOKIES_FILE=
# Cloud-only token server is disabled for the desktop app.
PO_TOKEN_SERVER_URL=
